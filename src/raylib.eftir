// TODO: fix multi-handler stack frame handling, State effect does not seem to chop off at the correct spot

#def fn f {
#{f}:
#}

#def call f {
    push_frame #{'"' ++ f ++ '"'}
    ret_ip = ip + 2
    jmp :#{f}
#}

#def prepare_call f {
    push_frame #{'"' ++ f ++ '"'}
#}

#def call_arg n {
    $0.#{n} =
#}

#def call_exec f {
    ret_ip = ip + 2
    jmp :#{f}
#}

#def reg_handler id n {
    push_handler #{id} :#{n ++ "_handler"}
    jmp :#{n ++ "_handler_scope"}
    pop_handler #{id}
#}

#def handler_scope n {
#{n ++ "_handler_scope"}:
#}

#def extern n {
    call_extern #{'"' ++ n ++ '"'}
#}

fn(main)
    push_frame "main"
    ret_ip = :end
    reg_handler(0, finally)
    ret void

// handler_scope(finally)
//     $0.x = 0 :: i32
//     $0.y = 0 :: i32
//     reg_handler(1, state)
//     ret void

// #def state_get field var {
//     push_frame #{'"' ++ field ++ "_get" ++ '"'}
//     perform 1 #{'"' ++ field ++ "_get" ++ '"'}
//     $0.#{var} = payload
// #}
// 
// #def state_set field var {
//     push_frame #{'"' ++ field ++ "_set" ++ '"'}
//     $0.#{field ++ "_"} = $.#{var}
//     perform 1 #{'"' ++ field ++ "_set" ++ '"'}
// #}

#def state_get field var {
    r0 = whereis state_handler_closure
    $0.#{var} = $[r0].#{field}
#}

#def state_set field var {
    r0 = whereis state_handler_closure
    $[r0].#{field} = $.#{var}
#}

// handler_scope(state)
handler_scope(finally)
    $0.x = 0 :: i32
    $0.y = 0 :: i32
    $0.state_handler_closure = void

    push_frame "finally"
    $0.f = function :main_finally_f
    perform 0 "finally"

    // init raylib
    extern(initWindow) [ 800 :: i32 600 :: i32 "EffectVM Raylib" ]
    extern(setWindowPosition) [ 24 :: i32 24 :: i32 ]

    // call while
    prepare_call(while)
    call_arg(pred) function :while_pred
    call_arg(body) function :while_body
    call_exec(while)

while_pred:
    extern(windowShouldClose) []
    jz ret_reg :while_pred_true
while_pred_false:
    //free ret_reg
    ret 0 :: u8
while_pred_true:
    //free ret_reg
    ret 1 :: u8

while_body:
    state_get(x, x)
    state_set(x, x)
    extern(isKeyDown) [ 65 :: u32 ]
    jz ret_reg :while_body_if_1
    //free ret_reg
    state_get(x, x)
    $.x -= 1 :: i32
    state_set(x, x)
    //jmp ip + 2
while_body_if_1:
    //free ret_reg
    extern(isKeyDown) [ 68 :: u32 ]
    jz ret_reg :while_body_if_2
    //free ret_reg
    state_get(x, x)
    $.x += 1 :: i32
    state_set(x, x)
    jmp ip + 2
while_body_if_2:
    //free ret_reg
    extern(isKeyDown) [ 87 :: u32 ]
    jz ret_reg :while_body_if_3
    //free ret_reg
    state_get(y, y)
    $.y -= 1 :: i32
    state_set(y, y)
    //jmp ip + 2
while_body_if_3:
    //free ret_reg
    extern(isKeyDown) [ 83 :: u32 ]
    jz ret_reg :while_body_draw
    //free ret_reg
    state_get(y, y)
    $.y += 1 :: i32
    state_set(y, y)
    //jmp ip + 2
while_body_draw:
    //free ret_reg
    extern(beginDrawing) []
    extern(clearBackground) [ {77 88 99 255} ]
    extern(drawRectangle) [ $.x $.y 100 :: i32 100 :: i32 {255 255 255 255} ]
    extern(drawFPS) [ 5 :: i32 5 :: i32 ]
    extern(endDrawing) []
    ret void

while:
    prepare_call(pred)
    ret_ip = ip + 2
    jmp $.pred
    jz ret_reg :while_end
    prepare_call(body)
    ret_ip = ip + 2
    jmp $.body
    jmp :while
while_end:
    ret void

finally_handler:
    resume void
    call(f)
    ret void

main_finally_f:
    extern(closeWindow) []
    print "now program is complete"
    ret void

